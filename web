                gallery: ['https://images.unsplash.com/photo-1622560480605-d83c853bc5c3?q=80&w=600'],
                specs: ['Breathable Air-Mesh Backing', 'Dual Mesh Water Bottle Holders', 'Scratch Resistant Nylon Material', 'Lightweight 420g Design']
            }
        ];

        // 2. STATE MANAGEMENT
        let cart = [];
        let wishlist = new Set();
        let placedOrders = [];
        let currentSlide = 0;
        let selectedCategory = 'All';
        let appliedDiscountPercent = 0;

        // 3. INITIALIZATION
        window.onload = function() {
            lucide.createIcons();
            renderProducts(PRODUCTS);
            startHeroCarousel();
            startCountdownTimer();
            updateCartUI();
        };

        // 4. CAROUSEL & TIMER
        function startHeroCarousel() {
            setInterval(() => moveSlide(1), 5000);
        }

        function setSlide(index) {
            const slides = document.querySelectorAll('.carousel-slide');
            const dots = document.querySelectorAll('#carousel-dots button');
            slides[currentSlide].classList.add('opacity-0');
            slides[currentSlide].classList.remove('opacity-100');
            dots[currentSlide].className = 'w-3 h-3 rounded-full bg-slate-600 hover:bg-slate-400 transition-all';

            currentSlide = index;
            if (currentSlide >= slides.length) currentSlide = 0;
            if (currentSlide < 0) currentSlide = slides.length - 1;

            slides[currentSlide].classList.remove('opacity-0');
            slides[currentSlide].classList.add('opacity-100');
            dots[currentSlide].className = 'w-3 h-3 rounded-full bg-amber-400 transition-all';
        }

        function moveSlide(direction) {
            setSlide(currentSlide + direction);
        }

        function startCountdownTimer() {
            let hours = 11, minutes = 28, seconds = 45;
            setInterval(() => {
                seconds--;
                if (seconds < 0) {
                    seconds = 59;
                    minutes--;
                    if (minutes < 0) {
                        minutes = 59;
                        hours--;
                    }
                }
                document.getElementById('timer-hours').innerText = hours.toString().padStart(2, '0');
                document.getElementById('timer-minutes').innerText = minutes.toString().padStart(2, '0');
                document.getElementById('timer-seconds').innerText = seconds.toString().padStart(2, '0');
            }, 1000);
        }

        // 5. PRODUCT RENDERING
        function renderProducts(items) {
            const grid = document.getElementById('product-grid');
            const noResults = document.getElementById('no-results-view');
            grid.innerHTML = '';

            if (items.length === 0) {
                noResults.classList.remove('hidden');
                return;
            } else {
                noResults.classList.add('hidden');
            }

            items.forEach(product => {
                const discount = Math.round(((product.originalPrice - product.price) / product.originalPrice) * 100);
                const isWishlisted = wishlist.has(product.id);

                const card = document.createElement('div');
                card.className = 'group bg-slate-900 border border-slate-800 hover:border-slate-700 rounded-3xl p-4 flex flex-col justify-between transition-all hover:shadow-2xl hover:-translate-y-1 relative';

                card.innerHTML = `
                    <div>
                        <!-- Image Container -->
                        <div class="relative h-48 w-full rounded-2xl overflow-hidden bg-slate-950 mb-4 cursor-pointer" onclick="openQuickView('${product.id}')">
                            <img src="${product.image}" alt="${product.title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            
                            <!-- Discount Badge -->
                            <span class="absolute top-3 left-3 bg-rose-500 text-white font-black text-[10px] px-2 py-0.5 rounded-full shadow">
                                -${discount}% OFF
                            </span>

                            <!-- Wishlist Button -->
                            <button onclick="event.stopPropagation(); toggleWishlist('${product.id}')" class="absolute top-3 right-3 w-8 h-8 rounded-full bg-slate-950/70 hover:bg-slate-950 text-slate-300 hover:text-rose-500 flex items-center justify-center transition-colors">
                                <i data-lucide="heart" class="w-4 h-4 ${isWishlisted ? 'fill-rose-500 text-rose-500' : ''}"></i>
                            </button>
                        </div>

                        <!-- Category & Prime -->
                        <div class="flex items-center justify-between text-[11px] mb-1.5">
                            <span class="text-amber-400 font-extrabold uppercase tracking-wider">${product.category}</span>
                            ${product.prime ? '<span class="px-2 py-0.5 bg-amber-500/10 border border-amber-500/30 text-amber-400 font-extrabold rounded-full text-[9px] flex items-center gap-1"><i data-lucide="zap" class="w-3 h-3 fill-current"></i> PRIME</span>' : ''}
                        </div>

                        <!-- Title -->
                        <h3 onclick="openQuickView('${product.id}')" class="font-bold text-sm text-white hover:text-amber-400 cursor-pointer transition-colors line-clamp-2 mb-2 leading-snug">
                            ${product.title}
                        </h3>

                        <!-- Rating -->
                        <div class="flex items-center gap-1 text-xs mb-3">
                            <div class="flex items-center text-amber-400">
                                <i data-lucide="star" class="w-3.5 h-3.5 fill-current"></i>
                                <span class="font-extrabold ml-1 text-white">${product.rating}</span>
                            </div>
                            <span class="text-slate-500">(${product.reviews})</span>
                        </div>
                    </div>

                    <!-- Price & Actions -->
                    <div>
                        <div class="flex items-baseline gap-2 mb-3">
                            <span class="text-lg font-black text-white">₹${product.price.toLocaleString()}</span>
                            <span class="text-xs text-slate-500 line-through">₹${product.originalPrice.toLocaleString()}</span>
                        </div>

                        <div class="grid grid-cols-2 gap-2">
                            <button onclick="addToCart('${product.id}')" class="w-full py-2 bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs rounded-xl transition-colors flex items-center justify-center gap-1">
                                <i data-lucide="shopping-cart" class="w-3.5 h-3.5 text-amber-400"></i> Add
                            </button>
                            <button onclick="buyNow('${product.id}')" class="w-full py-2 bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold text-xs rounded-xl shadow transition-colors">
                                Buy Now
                            </button>
                        </div>
                    </div>
                `;

                grid.appendChild(card);
            });
            lucide.createIcons();
        }

        // 6. FILTER LOGIC
        function triggerSearch() { applyFilters(); }

        function clearSearch() {
            document.getElementById('search-input').value = '';
            document.getElementById('clear-search').classList.add('hidden');
            applyFilters();
        }

        document.getElementById('search-input').addEventListener('input', function(e) {
            const clearBtn = document.getElementById('clear-search');
            if (e.target.value.trim() !== '') clearBtn.classList.remove('hidden');
            else clearBtn.classList.add('hidden');
            applyFilters();
        });

        function filterByCategory(category) {
            selectedCategory = category;
            const categoryBadge = document.getElementById('active-category-badge');
            if (category !== 'All') {
                categoryBadge.innerText = category;
                categoryBadge.classList.remove('hidden');
            } else {
                categoryBadge.classList.add('hidden');
            }
            applyFilters();
        }

        function applyFilters() {
            const query = document.getElementById('search-input').value.toLowerCase().trim();
            const categorySelect = document.getElementById('search-category').value;
            const priceRange = document.getElementById('filter-price-range').value;
            const sortBy = document.getElementById('filter-sort-by').value;

            let filtered = PRODUCTS.filter(p => {
                const matchesQuery = p.title.toLowerCase().includes(query) || p.category.toLowerCase().includes(query);
                
                let matchesCategory = true;
                if (selectedCategory !== 'All') {
                    matchesCategory = p.category === selectedCategory;
                } else if (categorySelect !== 'All') {
                    matchesCategory = p.category === categorySelect;
                }

                let matchesPrice = true;
                if (priceRange === 'under-1000') matchesPrice = p.price < 1000;
                else if (priceRange === '1000-3000') matchesPrice = p.price >= 1000 && p.price <= 3000;
                else if (priceRange === 'above-3000') matchesPrice = p.price > 3000;

                return matchesQuery && matchesCategory && matchesPrice;
            });

            if (sortBy === 'price-low') filtered.sort((a, b) => a.price - b.price);
            else if (sortBy === 'price-high') filtered.sort((a, b) => b.price - a.price);
            else if (sortBy === 'rating') filtered.sort((a, b) => b.rating - a.rating);

            document.getElementById('results-count-text').innerText = `Showing ${filtered.length} items`;
            renderProducts(filtered);
        }

        function resetFilters() {
            selectedCategory = 'All';
            document.getElementById('search-input').value = '';
            document.getElementById('search-category').value = 'All';
            document.getElementById('filter-price-range').value = 'all';
            document.getElementById('filter-sort-by').value = 'featured';
            document.getElementById('active-category-badge').classList.add('hidden');
            document.getElementById('clear-search').classList.add('hidden');
            renderProducts(PRODUCTS);
        }

        // 7. WISHLIST TOGGLE
        function toggleWishlist(id) {
            if (wishlist.has(id)) wishlist.delete(id);
            else wishlist.add(id);
            applyFilters();
        }

        function toggleWishlistOnly() {
            const wishlisted = PRODUCTS.filter(p => wishlist.has(p.id));
            renderProducts(wishlisted);
            document.getElementById('results-count-text').innerText = `Showing Wishlist (${wishlisted.length})`;
        }

        // 8. CART & COUPON LOGIC
        function addToCart(productId) {
            const idx = cart.findIndex(i => i.id === productId);
            if (idx > -1) {
                cart[idx].quantity++;
            } else {
                const prod = PRODUCTS.find(p => p.id === productId);
                cart.push({ ...prod, quantity: 1 });
            }
            updateCartUI();
            toggleCartDrawer(true);
        }

        function buyNow(productId) {
            addToCart(productId);
            openCheckoutModal();
        }

        function updateQuantity(productId, delta) {
            const idx = cart.findIndex(i => i.id === productId);
            if (idx > -1) {
                cart[idx].quantity += delta;
                if (cart[idx].quantity <= 0) cart.splice(idx, 1);
            }
            updateCartUI();
        }

        function applyCoupon() {
            const code = document.getElementById('coupon-input').value.trim().toUpperCase();
            const feedback = document.getElementById('coupon-feedback');
            if (code === 'DIWALI2026') {
                appliedDiscountPercent = 15;
                feedback.innerText = '✓ Diwali 15% OFF Coupon Applied!';
                feedback.className = 'text-[11px] mt-1 font-bold text-emerald-400';
            } else {
                appliedDiscountPercent = 0;
                feedback.innerText = '❌ Invalid Coupon Code. Try DIWALI2026';
                feedback.className = 'text-[11px] mt-1 font-bold text-rose-400';
            }
            updateCartUI();
        }

        function updateCartUI() {
            const count = cart.reduce((s, i) => s + i.quantity, 0);
            const subtotal = cart.reduce((s, i) => s + (i.price * i.quantity), 0);
            const discount = Math.round((subtotal * appliedDiscountPercent) / 100);
            const total = subtotal - discount;

            document.getElementById('cart-counter').innerText = count;
            document.getElementById('drawer-cart-count').innerText = count;
            document.getElementById('cart-total-header').innerText = `₹${total.toLocaleString()}`;
            document.getElementById('cart-subtotal').innerText = `₹${subtotal.toLocaleString()}`;

            if (discount > 0) {
                document.getElementById('discount-row').classList.remove('hidden');
                document.getElementById('cart-discount').innerText = `-₹${discount.toLocaleString()}`;
            } else {
                document.getElementById('discount-row').classList.add('hidden');
            }

            document.getElementById('cart-total').innerText = `₹${total.toLocaleString()}`;

            // Free Shipping Threshold (₹999)
            const threshold = 999;
            const progress = Math.min((subtotal / threshold) * 100, 100);
            document.getElementById('free-shipping-bar').style.width = `${progress}%`;
            document.getElementById('free-shipping-percent').innerText = `${Math.round(progress)}%`;

            if (subtotal >= threshold) {
                document.getElementById('free-shipping-msg').innerText = '🎉 FREE Class Express Delivery Unlocked!';
            } else {
                const diff = threshold - subtotal;
                document.getElementById('free-shipping-msg').innerText = `Add ₹${diff.toLocaleString()} for FREE Delivery`;
            }

            // Render Cart Drawer
            const container = document.getElementById('cart-items-container');
            container.innerHTML = '';

            if (cart.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-12 text-slate-500 space-y-3">
                        <i data-lucide="shopping-bag" class="w-12 h-12 mx-auto stroke-1"></i>
                        <div class="font-extrabold text-sm text-slate-300">Your cart is empty</div>
                        <p class="text-xs">Explore Diwali specials, audio gear, and travel bags!</p>
                    </div>
                `;
                document.getElementById('checkout-btn').disabled = true;
            } else {
                document.getElementById('checkout-btn').disabled = false;
                cart.forEach(item => {
                    const el = document.createElement('div');
                    el.className = 'flex items-center gap-3 p-3 bg-slate-950 rounded-2xl border border-slate-800';
                    el.innerHTML = `
                        <img src="${item.image}" alt="${item.title}" class="w-16 h-16 rounded-xl object-cover border border-slate-800">
                        <div class="flex-1 min-w-0">
                            <h4 class="font-bold text-xs text-white truncate">${item.title}</h4>
                            <div class="text-amber-400 font-extrabold text-xs mt-0.5">₹${(item.price * item.quantity).toLocaleString()}</div>
                            
                            <div class="flex items-center gap-2 mt-2">
                                <button onclick="updateQuantity('${item.id}', -1)" class="w-6 h-6 rounded-lg bg-slate-800 text-white flex items-center justify-center font-bold text-xs">-</button>
                                <span class="text-xs font-extrabold text-white px-1">${item.quantity}</span>
                                <button onclick="updateQuantity('${item.id}', 1)" class="w-6 h-6 rounded-lg bg-slate-800 text-white flex items-center justify-center font-bold text-xs">+</button>
                            </div>
                        </div>
                        <button onclick="updateQuantity('${item.id}', -${item.quantity})" class="text-slate-500 hover:text-rose-500 p-1">
                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                        </button>
                    `;
                    container.appendChild(el);
                });
            }
            lucide.createIcons();
        }

        function toggleCartDrawer(open) {
            const drawer = document.getElementById('cart-drawer');
            if (open) drawer.classList.remove('hidden');
            else drawer.classList.add('hidden');
        }

        // 9. QUICK VIEW MODAL
        function openQuickView(id) {
            const product = PRODUCTS.find(p => p.id === id);
            const content = document.getElementById('quickview-content');
            
            content.innerHTML = `
                <div>
                    <img src="${product.image}" alt="${product.title}" class="w-full h-80 object-cover rounded-2xl border border-slate-800 mb-3">
                </div>

                <div class="space-y-4">
                    <div>
                        <span class="px-2.5 py-1 bg-amber-500/10 border border-amber-500/30 text-amber-400 font-extrabold text-xs rounded-full uppercase">${product.category}</span>
                        <h2 class="text-xl font-extrabold text-white mt-2">${product.title}</h2>
                        <div class="flex items-center gap-2 mt-2 text-xs">
                            <span class="text-amber-400 font-bold flex items-center gap-1"><i data-lucide="star" class="w-4 h-4 fill-current"></i> ${product.rating}</span>
                            <span class="text-slate-500">| ${product.reviews} Reviews</span>
                        </div>
                    </div>

                    <div class="flex items-baseline gap-3">
                        <span class="text-2xl font-black text-amber-400">₹${product.price.toLocaleString()}</span>
                        <span class="text-sm text-slate-500 line-through">₹${product.originalPrice.toLocaleString()}</span>
                    </div>

                    <div class="space-y-2">
                        <div class="text-xs font-extrabold text-slate-300 uppercase tracking-wider">Specifications</div>
                        <ul class="space-y-1 text-xs text-slate-400">
                            ${product.specs.map(s => `<li class="flex items-center gap-2"><i data-lucide="check" class="w-3.5 h-3.5 text-amber-400"></i> ${s}</li>`).join('')}
                        </ul>
                    </div>

                    <div class="pt-4">
                        <button onclick="addToCart('${product.id}'); closeModal('quickview-modal');" class="w-full py-3 bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold rounded-xl text-xs transition-colors">
                            Add to Shopping Cart
                        </button>
                    </div>
                </div>
            `;

            lucide.createIcons();
            openModal('quickview-modal');
        }

        // 10. CHECKOUT FLOW
        function openCheckoutModal() {
            toggleCartDrawer(false);
            const summaryList = document.getElementById('checkout-summary-list');
            summaryList.innerHTML = '';
            
            const subtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
            const discount = Math.round((subtotal * appliedDiscountPercent) / 100);
            const total = subtotal - discount;

            cart.forEach(item => {
                const el = document.createElement('div');
                el.className = 'pt-2 flex justify-between items-center text-slate-300';
                el.innerHTML = `
                    <span class="truncate max-w-[200px]">${item.quantity}x ${item.title}</span>
                    <span class="font-bold">₹${(item.price * item.quantity).toLocaleString()}</span>
                `;
                summaryList.appendChild(el);
            });

            document.getElementById('checkout-final-total').innerText = `₹${total.toLocaleString()}`;
            openModal('checkout-modal');
        }

        function placeOrder() {
            closeModal('checkout-modal');
            const orderId = '#CC-' + Math.floor(10000 + Math.random() * 90000);
            document.getElementById('order-id-display').innerText = orderId;

            placedOrders.push({
                id: orderId,
                date: new Date().toLocaleDateString(),
                items: [...cart],
                total: document.getElementById('checkout-final-total').innerText
            });

            confetti({ particleCount: 120, spread: 80, origin: { y: 0.6 } });

            cart = [];
            updateCartUI();
            openModal('order-success-modal');
            renderPlacedOrders();
        }

        function renderPlacedOrders() {
            const list = document.getElementById('placed-orders-list');
            list.innerHTML = '';

            if (placedOrders.length === 0) {
                list.innerHTML = `<div class="text-center py-8 text-slate-400 text-xs">No recent orders placed yet.</div>`;
                return;
            }

            placedOrders.forEach(order => {
                const card = document.createElement('div');
                card.className = 'p-4 bg-slate-950 rounded-2xl border border-slate-800 space-y-2 text-xs';
                card.innerHTML = `
                    <div class="flex justify-between items-center text-slate-400">
                        <span class="font-bold text-white">${order.id}</span>
                        <span>Placed on: ${order.date}</span>
                    </div>
                    <div class="text-slate-300">
                        ${order.items.map(i => `${i.quantity}x ${i.title}`).join(', ')}
                    </div>
                    <div class="flex justify-between items-center pt-2 border-t border-slate-800">
                        <span class="text-emerald-400 font-bold">Status: Express Shipping</span>
                        <span class="text-amber-400 font-extrabold">${order.total}</span>
                    </div>
                `;
                list.appendChild(card);
            });
        }

        function closeSuccessModal() { closeModal('order-success-modal'); }

        function updateLocation() {
            const val = document.getElementById('pincode-input').value.trim();
            if (val) {
                document.getElementById('current-location-text').innerText = val;
                closeModal('location-modal');
            }
        }

        function openModal(id) { document.getElementById(id).classList.remove('hidden'); }
        function closeModal(id) { document.getElementById(id).classList.add('hidden'); }
    </script>
</body>
</html>
